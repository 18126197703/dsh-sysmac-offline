{
  "name": "dsh-sysmac-offline",
  "version": "0.1.1",
  "description": "Read OMRON Sysmac Studio .smc2 projects offline inside DeepSeek Harness: variable tables (SLWD), the .oem entity hierarchy and ladder-logic PouBody source. No Sysmac Studio, no network, no Python.",
  "type": "module",
  "license": "MIT",
  "author": "18126197703",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/18126197703/dsh-sysmac-offline.git"
  },
  "homepage": "https://github.com/18126197703/dsh-sysmac-offline",
  "bugs": {
    "url": "https://github.com/18126197703/dsh-sysmac-offline/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "omron",
    "sysmac",
    "sysmac-studio",
    "smc2",
    "plc",
    "ladder",
    "iec-61131-3",
    "industrial-automation",
    "offline"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "sideEffects": false
}
